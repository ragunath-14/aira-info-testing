# ============================================================================
# AIRAOS Infra Console — environment template
# Copy to .env and fill in. NEVER commit a populated .env.
# ============================================================================

# ---------------------------------------------------------------- Runtime ---
NODE_ENV=development
# Which infrastructure environment THIS console instance considers "self".
APP_ENV=development
APP_URL=http://localhost:3000
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------------------- Database ---
# Console's own PostgreSQL (users, RBAC, audit, registries). NOT a managed target.
DATABASE_URL=postgres://airaos:airaos@localhost:5432/airaos_console
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ----------------------------------------------------------------- Crypto ---
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
# Encrypts provider tokens and DB credentials at rest. Rotating it invalidates
# every stored secret — see docs/security.md.
ENCRYPTION_KEY=
# Independent key used to chain-hash audit records (tamper evidence).
AUDIT_LOG_SECRET=
# Signs console session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=

# ------------------------------------------------------- AIRAOS Auth (SSO) ---
# Central AIRAOS identity provider. When unset, the console falls back to
# LOCAL_AUTH (development only — refuses to start with NODE_ENV=production).
AIRAOS_AUTH_URL=
AIRAOS_AUTH_CLIENT_ID=
AIRAOS_AUTH_SECRET=
AIRAOS_AUTH_ISSUER=
AIRAOS_AUTH_JWKS_URL=
# Require MFA claim (amr contains "mfa") on every session.
AUTH_REQUIRE_MFA=true
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60

# Development-only local login. Ignored unless NODE_ENV!=production.
LOCAL_AUTH_ENABLED=true

# ---------------------------------------------------------- DigitalOcean ---
# Use a SCOPED read token for monitoring. A second, separately-scoped token may
# be supplied for the small set of write actions (reboot/power/snapshot).
DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_WRITE_API_TOKEN=
DIGITALOCEAN_API_URL=https://api.digitalocean.com/v2

# --------------------------------------------------------------- Proxmox ---
# Prefer a scoped API token (PVEAPIToken), never root@pam password auth.
PROXMOX_API_URL=https://proxmox.internal:8006/api2/json
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Set to false only with a properly trusted internal CA configured below.
PROXMOX_TLS_REJECT_UNAUTHORIZED=true
PROXMOX_CA_CERT_PATH=

# ---------------------------------------------------------------- Docker ---
# Optional. Enables container status + allowlisted restart for the services
# named below. The socket is read by the API only; it is never proxied to the
# browser, and containers outside this list cannot be touched at all.
DOCKER_SOCKET_PATH=
DOCKER_ALLOWED_CONTAINERS=airaos-api,airaos-web,airaos-worker

# ------------------------------------------------------------ Monitoring ---
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
GRAFANA_URL=http://localhost:3001
# Optional read-only Grafana token used only for building deep links / embeds.
GRAFANA_TOKEN=
# Optional basic-auth for a protected Prometheus.
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# ----------------------------------------------------------------- Redis ---
# Console cache + rate limiting. Falls back to in-process cache when unset.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------- Query guardrails ---
DB_QUERY_TIMEOUT_MS=15000
DB_QUERY_MAX_ROWS=1000
DB_QUERY_MAX_CONNECTIONS_PER_TARGET=5
# Minutes a production write window stays open after activation.
DB_WRITE_MODE_TTL_MINUTES=15

# ------------------------------------------------ Docker compose only ---
# Consumed by docker/docker-compose.yml, not by the application itself.
# Compose refuses to start without the two passwords.
POSTGRES_USER=airaos
POSTGRES_PASSWORD=
POSTGRES_DB=airaos_console
GRAFANA_ADMIN_PASSWORD=

# Alert receiver webhooks used by monitoring/alertmanager/alertmanager.yml.
# These are credentials: never commit a populated value.
ALERT_WEBHOOK_PRODUCTION_CRITICAL=
ALERT_WEBHOOK_CRITICAL=
ALERT_WEBHOOK_WARNING=
ALERT_WEBHOOK_INFO=

# -------------------------------------------------------------- Web (SSR) ---
# Server-side base URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://127.0.0.1:4000
# Browser-visible base path. Keep it a same-origin proxy path in production.
NEXT_PUBLIC_API_BASE_URL=/api/proxy
NEXT_PUBLIC_APP_ENV=development
