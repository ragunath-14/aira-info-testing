{
  "name": "@airaos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "connections:import": "tsx --env-file=../../.env src/connections/import-env.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "retention": "tsx --env-file=../../.env src/db/retention.ts",
    "seed": "tsx --env-file=../../.env src/db/seed.ts",
    "start": "node dist/index.js",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:security": "vitest run --dir tests/security",
    "test:unit": "vitest run --dir tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@airaos/config": "1.0.0",
    "@airaos/types": "1.0.0",
    "@airaos/validation": "1.0.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  }
}
